      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "FalseAlarm",
      "label_zh": "虚警",
      "label_en": "False alarm",
      "aliases": [],
      "context": "诊断",
      "definition": "按约定规则确认无对应故障的报警",
      "constraints": "CND/RTOK不自动等于虚警；见[06](06-使用与改进.md)",
      "source_level": "G+M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "Baseline",
      "label_zh": "基线",
      "label_en": "Baseline",
      "aliases": [],
      "context": "需求/配置",
      "definition": "受控版本集合",
      "constraints": "可被替代，历史身份不变",
      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "Configuration",
      "label_zh": "配置",
      "label_en": "Configuration",
      "aliases": [],
      "context": "执行",
      "definition": "被测对象、依赖、参数、数据与环境组合",
      "constraints": "“最新版”不是可复现身份",
      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "Observation",
      "label_zh": "观察",
      "label_en": "Observation",
      "aliases": [
        "实测值（数值）"
      ],
      "context": "执行",
      "definition": "实际采集的输出、事件、数值和时间",
      "constraints": "不为迁就预期修改失败观察",
      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "ExpectedOutcome",
      "label_zh": "预期",
      "label_en": "Expected outcome",
      "aliases": [
        "预期结果"
      ],
      "context": "设计",
      "definition": "需求/模型推导的目标行为或范围",
      "constraints": "执行前确定；不复制被测实现作独立答案",
      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "AcceptanceCriterion",
      "label_zh": "判据",
      "label_en": "Acceptance criterion",
      "aliases": [
        "合格判据"
      ],
      "context": "设计",
      "definition": "观察到判定的比较规则",
      "constraints": "执行/评价引用发布版本；含单位、容差、时间窗、缺失数据；阈值不等于置信结论",
      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    }
  ]
}
