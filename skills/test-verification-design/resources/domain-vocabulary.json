      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "Verdict",
      "label_zh": "判定",
      "label_en": "Verdict",
      "aliases": [],
      "context": "执行",
      "definition": "按既定判据对特定结果作出的通过、失败等决定",
      "constraints": "绑定结果与判据版本，评价引用不反写；不等同生命周期或产品验收结论",
      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "Evidence",
      "label_zh": "证据",
      "label_en": "Evidence",
      "aliases": [],
      "context": "证据",
      "definition": "支持具体主张的可追源信息/工件",
      "constraints": "带配置、时间和方法；有文件不等于充分",
      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "Conclusion",
      "label_zh": "结论",
      "label_en": "Conclusion",
      "aliases": [],
      "context": "评价",
      "definition": "有责任人、范围、依据及限制的判断",
      "constraints": "用例通过不能扩大成产品全面合格",
      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "EquipmentTestability",
      "label_zh": "装备测试性",
      "label_en": "Equipment testability",
      "aliases": [],
      "context": "诊断",
      "definition": "判断工作状态及检测/隔离故障的能力",
