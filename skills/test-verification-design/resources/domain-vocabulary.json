  "terms": [
    {
      "canonical_name": "Requirement",
      "label_zh": "需求",
      "label_en": "Requirement",
      "aliases": [
        "要求"
      ],
      "context": "需求",
      "definition": "产品能力、质量或约束的版本化陈述",
      "constraints": "带来源；实现现状不自动成为需求",
      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "Verification",
      "label_zh": "验证",
      "label_en": "Verification",
      "aliases": [],
      "context": "设计/评价",
      "definition": "评价是否满足规定要求",
      "constraints": "包括分析、检查、演示、测试；不等于仅运行测试",
      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "Validation",
      "label_zh": "确认",
      "label_en": "Validation",
      "aliases": [],
      "context": "产品/评价",
      "definition": "在使用情境下评价预期用途与用户需要",
      "constraints": "不等于审批；“结果确认”依项目原义",
      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "Test",
      "label_zh": "测试",
      "label_en": "Test",
      "aliases": [],
      "context": "设计/执行",
      "definition": "约定条件下施加输入/观察行为并记录结果",
      "constraints": "是验证方法之一；不等于测试性",
      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "TestDesign",
      "label_zh": "测试设计",
      "label_en": "Test design",
      "aliases": [],
      "context": "设计",
      "definition": "依据需求、风险和模型确定条件、覆盖策略、判据和设计关系",
      "constraints": "是设计活动/产物，不等于用例执行或结果",
      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "VerificationObjective",
      "label_zh": "验证目标",
      "label_en": "Verification objective",
      "aliases": [],
      "context": "设计",
      "definition": "明确要证明的要求或预期用途及其评价范围",
      "constraints": "由设计维护版本，评价按版本引用；区分verification与validation目标",
      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "EngineeringTrial",
      "label_zh": "试验",
      "label_en": "Experiment/Trial",
      "aliases": [],
      "context": "试验设计",
      "definition": "有目的、对象、条件与方案的工程活动",
      "constraints": "装备试验沿原标准术语；不强译所有Test",
      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "Scenario",
      "label_zh": "场景",
      "label_en": "Scenario",
      "aliases": [],
      "context": "产品/设计",
      "definition": "角色情境中的事件序列",
      "constraints": "包含异常路径；不自动成为可执行用例",
      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "TestCase",
      "label_zh": "用例",
      "label_en": "Test case",
      "aliases": [
        "测试用例"
      ],
      "context": "设计",
      "definition": "前置、输入、操作、预期和判据的设计项",
