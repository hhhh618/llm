      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "TestProcedure",
      "label_zh": "规程",
      "label_en": "Test procedure",
      "aliases": [
        "测试程序"
      ],
      "context": "设计",
      "definition": "步骤、工具、采集及恢复方法",
      "constraints": "脚本为实现/附件；脚本名不证明规程完整",
      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "VerificationPlan",
      "label_zh": "验证计划",
      "label_en": "Verification plan",
      "aliases": [],
      "context": "管理",
      "definition": "范围、目标、资源、责任、方法、时机与退出条件",
      "constraints": "TestPlan为测试子计划，不等于规程或用例集",
      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "TestExecution",
      "label_zh": "执行",
      "label_en": "Test execution",
      "aliases": [
        "Run",
        "TestRun"
      ],
      "context": "执行",
      "definition": "固定设计/配置的一次运行",
      "constraints": "TestRun为别名；默认类型统一用TestExecution；重跑新建身份，不覆盖旧失败",
      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "TestResult",
      "label_zh": "结果",
      "label_en": "Test result",
      "aliases": [],
      "context": "执行",
      "definition": "本次观察、测量和步骤结果的结构化记录，可引用Verdict",
