      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "Anomaly",
      "label_zh": "异常",
      "label_en": "Anomaly",
      "aliases": [],
      "context": "改进",
      "definition": "由偏离预期的观察提出、需要调查的问题记录",
