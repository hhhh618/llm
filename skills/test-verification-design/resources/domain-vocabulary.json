      "source_level": "G+M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "SoftwareTestability",
      "label_zh": "软件可测试性",
      "label_en": "Software testability",
      "aliases": [],
      "context": "软件设计",
      "definition": "建立条件、控制输入、观察行为、隔离依赖及重复验证的能力",
      "constraints": "细化可观测性、可控性与成本，不套诊断指标",
      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "DiagnosticFault",
      "label_zh": "故障",
      "label_en": "Fault",
      "aliases": [],
      "context": "诊断",
      "definition": "按产品模型识别的异常状态/原因或模式",
      "constraints": "对软件fault另建映射；告警不等于已证实故障",
      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "Failure",
      "label_zh": "失效",
      "label_en": "Failure",
      "aliases": [],
      "context": "产品",
      "definition": "不能实现规定功能/性能的可观察事件",
      "constraints": "区别根因、缺陷及测试工具崩溃",
      "source_level": "M",
      "source_resource": "resources/10-领域模型与统一语言.md"
    },
    {
      "canonical_name": "Defect",
      "label_zh": "缺陷",
      "label_en": "Defect",
      "aliases": [
        "Bug"
      ],
      "context": "改进",
      "definition": "需求、设计、实现或工件中的不满足项",
